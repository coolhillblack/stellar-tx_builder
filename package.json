{
  "name": "stellar-tx-builder",
  "version": "0.1.0",
  "description": "A visual, embeddable React component library for building Stellar transactions step-by-step",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "transaction",
    "builder",
    "react",
    "component",
    "xdr",
    "soroban",
    "web3",
    "dapp"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/stellar-tx-builder.git"
  },
  "homepage": "https://github.com/YOUR_ORG/stellar-tx-builder#readme",
  "bugs": {
    "url": "https://github.com/YOUR_ORG/stellar-tx-builder/issues"
  }
}
